+
+// ---------------------------------------------------------------------------
+// Multi-monitor support: the transparent window always covers one monitor.
+// When the cat is dragged onto another monitor, the window jumps there.
+// ---------------------------------------------------------------------------
+
+#[derive(serde::Serialize)]
+struct MonitorSwitch {
+    x: f64,
+    y: f64,
+    name: String,
+}
+
+fn cover_monitor(window: &tauri::WebviewWindow, monitor: &tauri::Monitor) -> Result<(), String> {
+    let pos = *monitor.position();
+    let size = *monitor.size();
+    let p = tauri::Position::Physical(tauri::PhysicalPosition::new(pos.x, pos.y));
+    let s = tauri::Size::Physical(tauri::PhysicalSize::new(size.width, size.height));
+    window.set_position(p.clone()).map_err(|e| e.to_string())?;
+    window.set_size(s.clone()).map_err(|e| e.to_string())?;
+    // Moving between monitors with different scaling can resize the window — apply again
+    window.set_position(p).map_err(|e| e.to_string())?;
+    window.set_size(s).map_err(|e| e.to_string())?;
+    Ok(())
+}
+
+fn same_monitor(a: &tauri::Monitor, b: &tauri::Monitor) -> bool {
+    a.position() == b.position() && a.size() == b.size()
+}
+
+#[tauri::command]
+fn switch_monitor_at_cursor(window: tauri::WebviewWindow) -> Result<Option<MonitorSwitch>, String> {
+    let cursor = window.cursor_position().map_err(|e| e.to_string())?;
+    let monitors = window.available_monitors().map_err(|e| e.to_string())?;
+    let target = monitors.into_iter().find(|m| {
+        let p = m.position();
+        let s = m.size();
+        cursor.x >= p.x as f64
+            && cursor.x < p.x as f64 + s.width as f64
+            && cursor.y >= p.y as f64
+            && cursor.y < p.y as f64 + s.height as f64
+    });
+    let Some(target) = target else { return Ok(None) };
+
+    // Compare with the monitor the window currently covers (by its top-left corner)
+    let origin = window.outer_position().map_err(|e| e.to_string())?;
+    let p = target.position();
+    if p.x == origin.x && p.y == origin.y {
+        return Ok(None);
+    }
+    if let Ok(Some(current)) = window.current_monitor() {
+        if same_monitor(&current, &target) && current.position().x == origin.x && current.position().y == origin.y {
+            return Ok(None);
+        }
+    }
+
+    cover_monitor(&window, &target)?;
+    let scale = target.scale_factor();
+    Ok(Some(MonitorSwitch {
+        x: (cursor.x - p.x as f64) / scale,
+        y: (cursor.y - p.y as f64) / scale,
+        name: target.name().cloned().unwrap_or_default(),
+    }))
+}
+
+#[tauri::command]
+fn move_to_monitor(window: tauri::WebviewWindow, name: String) -> Result<bool, String> {
+    let monitors = window.available_monitors().map_err(|e| e.to_string())?;
+    match monitors.iter().find(|m| m.name().map(|n| n == &name).unwrap_or(false)) {
+        Some(m) => {
+            cover_monitor(&window, m)?;
+            Ok(true)
+        }
+        None => Ok(false),
+    }
+}
