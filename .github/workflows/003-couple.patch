diff --git a/src/lib/look.ts b/src/lib/look.ts
new file mode 100644
index 0000000..76edb46
--- /dev/null
+++ b/src/lib/look.ts
@@ -0,0 +1,41 @@
+// Accessories the cat can wear. They unlock after a number of hours the app was running.
+// The chosen accessory travels to friends packed into the color field: "pink+crown".
+
+export interface Accessory {
+  id: string;
+  emoji: string;
+  name: string;
+  hours: number;
+  /** Fine-tuning of the vertical position (px, 64px sprite box). */
+  dy?: number;
+  size?: number;
+}
+
+export const ACCESSORIES: Accessory[] = [
+  { id: "bow", emoji: "🎀", name: "Schleife", hours: 1 },
+  { id: "flower", emoji: "🌸", name: "Blüte", hours: 2 },
+  { id: "heart", emoji: "💗", name: "Herzchen", hours: 4 },
+  { id: "cap", emoji: "🧢", name: "Cap", hours: 6, dy: -2 },
+  { id: "tophat", emoji: "🎩", name: "Zylinder", hours: 9, dy: -6 },
+  { id: "glasses", emoji: "🕶️", name: "Sonnenbrille", hours: 12, dy: 10, size: 16 },
+  { id: "tiara", emoji: "👑", name: "Krone", hours: 18, dy: -4 },
+  { id: "party", emoji: "🥳", name: "Partyhut", hours: 25, dy: -4 },
+  { id: "halo", emoji: "😇", name: "Heiligenschein", hours: 35, dy: -10 },
+  { id: "star", emoji: "🌟", name: "Sternchen", hours: 50, dy: -6 },
+  { id: "rainbow", emoji: "🌈", name: "Regenbogen", hours: 75, dy: -12, size: 22 },
+  { id: "unicorn", emoji: "🦄", name: "Einhorn", hours: 100, dy: -8 },
+];
+
+export function accessoryById(id?: string | null): Accessory | undefined {
+  if (!id) return undefined;
+  return ACCESSORIES.find((a) => a.id === id);
+}
+
+export function packColor(color: string, accessory?: string | null): string {
+  return accessory ? `${color}+${accessory}` : color;
+}
+
+export function unpackColor(packed: string): { color: string; accessory?: string } {
+  const [color, accessory] = (packed || "").split("+");
+  return { color, accessory: accessory || undefined };
+}
