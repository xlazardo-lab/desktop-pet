diff --git a/src/components/YarnBall.tsx b/src/components/YarnBall.tsx
new file mode 100644
index 0000000..b2b1f4e
--- /dev/null
+++ b/src/components/YarnBall.tsx
@@ -0,0 +1,156 @@
+import { forwardRef, useEffect, useImperativeHandle, useRef, useState } from "react";
+
+export interface YarnState {
+  x: number;
+  y: number;
+  vx: number;
+  vy: number;
+}
+
+export interface YarnHandle {
+  kick: (vx: number, vy: number) => void;
+  get: () => YarnState;
+  isResting: () => boolean;
+}
+
+interface YarnBallProps {
+  initial: YarnState;
+  /** Called when the ball leaves the screen sideways. Return true if it was sent away (ball disappears). */
+  onExit: (side: "left" | "right", yFrac: number, vx: number, vy: number) => boolean;
+  onPosition: (pos: { x: number; y: number }) => void;
+  onDragChange: (dragging: boolean) => void;
+  onGone: () => void;
+}
+
+const R = 14;
+const GRAVITY = 0.45;
+const IDLE_TIMEOUT = 90_000;
+
+const YarnBall = forwardRef<YarnHandle, YarnBallProps>(function YarnBall(
+  { initial, onExit, onPosition, onDragChange, onGone },
+  ref,
+) {
+  const s = useRef<YarnState>({ ...initial });
+  const [draw, setDraw] = useState({ x: initial.x, y: initial.y, rot: 0 });
+  const dragging = useRef(false);
+  const lastMoves = useRef<{ x: number; y: number; t: number }[]>([]);
+  const rot = useRef(0);
+  const lastActivity = useRef(Date.now());
+  const cbs = useRef({ onExit, onPosition, onDragChange, onGone });
+  cbs.current = { onExit, onPosition, onDragChange, onGone };
+
+  useImperativeHandle(ref, () => ({
+    kick: (vx, vy) => {
+      s.current.vx = vx;
+      s.current.vy = vy;
+      lastActivity.current = Date.now();
+    },
+    get: () => ({ ...s.current }),
+    isResting: () => {
+      const floor = window.innerHeight - R - 6;
+      return !dragging.current && s.current.y >= floor - 1 && Math.abs(s.current.vx) < 0.3 && Math.abs(s.current.vy) < 1;
+    },
+  }));
+
+  useEffect(() => {
+    let raf = 0;
+    let lastReport = 0;
+    let gone = false;
+    const step = (t: number) => {
+      const b = s.current;
+      const w = window.innerWidth;
+      const floor = window.innerHeight - R - 6;
+      if (!dragging.current) {
+        b.vy += GRAVITY;
+        b.x += b.vx;
+        b.y += b.vy;
+        if (b.y > floor) {
+          b.y = floor;
+          b.vy = Math.abs(b.vy) > 1.5 ? -b.vy * 0.55 : 0;
+          b.vx *= 0.96;
+        }
+        if (b.y < R) {
+          b.y = R;
+          b.vy = Math.abs(b.vy) * 0.5;
+        }
+        if (b.x < -R || b.x > w + R) {
+          const side = b.x < 0 ? "left" : "right";
+          const sent = cbs.current.onExit(side, Math.max(0.05, Math.min(0.9, b.y / window.innerHeight)), b.vx, b.vy);
+          if (sent) {
+            gone = true;
+            cbs.current.onGone();
+            return;
+          }
+          // Nobody to send it to: bounce back
+          b.x = side === "left" ? R : w - R;
+          b.vx = -b.vx * 0.6;
+        }
+        if (Math.abs(b.vx) < 0.05) b.vx = 0;
+        rot.current += b.vx * 4;
+        if (Math.abs(b.vx) > 0.3 || Math.abs(b.vy) > 1) lastActivity.current = Date.now();
+      } else {
+        lastActivity.current = Date.now();
+      }
+
+      if (Date.now() - lastActivity.current > IDLE_TIMEOUT) {
+        gone = true;
+        cbs.current.onGone();
+        return;
+      }
+
+      setDraw({ x: b.x, y: b.y, rot: rot.current });
+      if (t - lastReport > 80) {
+        lastReport = t;
+        cbs.current.onPosition({ x: b.x, y: b.y });
+      }
+      raf = requestAnimationFrame(step);
+    };
+    raf = requestAnimationFrame(step);
+    return () => {
+      cancelAnimationFrame(raf);
+      if (!gone) cbs.current.onPosition({ x: -999, y: -999 });
+    };
+  }, []);
+
+  const onMouseDown = (e: React.MouseEvent) => {
+    e.preventDefault();
+    e.stopPropagation();
+    dragging.current = true;
+    cbs.current.onDragChange(true);
+    lastMoves.current = [{ x: e.clientX, y: e.clientY, t: performance.now() }];
+    const move = (ev: MouseEvent) => {
+      s.current.x = ev.clientX;
+      s.current.y = ev.clientY;
+      lastMoves.current.push({ x: ev.clientX, y: ev.clientY, t: performance.now() });
+      if (lastMoves.current.length > 6) lastMoves.current.shift();
+    };
+    const up = () => {
+      window.removeEventListener("mousemove", move);
+      window.removeEventListener("mouseup", up);
+      const m = lastMoves.current;
+      const a = m[0];
+      const b = m[m.length - 1];
+      const dt = Math.max(16, b.t - a.t);
+      // px per frame (~16ms)
+      s.current.vx = Math.max(-40, Math.min(40, ((b.x - a.x) / dt) * 16));
+      s.current.vy = Math.max(-40, Math.min(40, ((b.y - a.y) / dt) * 16));
+      dragging.current = false;
+      cbs.current.onDragChange(false);
+    };
+    window.addEventListener("mousemove", move);
+    window.addEventListener("mouseup", up);
+  };
+
+  return (
+    <div
+      className="yarn-ball"
+      style={{ left: draw.x - R, top: draw.y - R, width: R * 2, height: R * 2, transform: `rotate(${draw.rot}deg)` }}
+      onMouseDown={onMouseDown}
+      title="Werfen! Raus über den Rand → landet bei deinem Schatz"
+    >
+      🧶
+    </div>
+  );
+});
+
+export default YarnBall;
diff --git a/src/hooks/useActiveTime.ts b/src/hooks/useActiveTime.ts
new file mode 100644
index 0000000..1487be7
--- /dev/null
+++ b/src/hooks/useActiveTime.ts
@@ -0,0 +1,36 @@
+import { useEffect, useRef, useState } from "react";
+import { ACCESSORIES, Accessory } from "../lib/look";
+
+const KEY = "active-minutes";
+
+function load(): number {
+  try {
+    return Number(localStorage.getItem(KEY) || "0") || 0;
+  } catch {
+    return 0;
+  }
+}
+
+/** Counts the minutes the app has been running; accessories unlock by hours. */
+export function useActiveTime(onUnlock?: (acc: Accessory) => void) {
+  const [minutes, setMinutes] = useState(load);
+  const onUnlockRef = useRef(onUnlock);
+  onUnlockRef.current = onUnlock;
+
+  useEffect(() => {
+    const id = setInterval(() => {
+      setMinutes((prev) => {
+        const next = prev + 1;
+        try { localStorage.setItem(KEY, String(next)); } catch { /* ignore */ }
+        const newly = ACCESSORIES.find((a) => a.hours * 60 === next);
+        if (newly) setTimeout(() => onUnlockRef.current?.(newly), 0);
+        return next;
+      });
+    }, 60_000);
+    return () => clearInterval(id);
+  }, []);
+
+  const hours = minutes / 60;
+  const isUnlocked = (acc: Accessory) => hours >= acc.hours;
+  return { minutes, hours, isUnlocked };
+}
