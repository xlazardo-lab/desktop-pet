 fn get_mouse_position() -> Result<MousePosition, String> {
     // Use the CoreGraphics C API directly to avoid leaking CGEvent/CGEventSource
@@ -119,3 +120,12 @@ fn get_mouse_position() -> Result<MousePosition, String> {
         })
     }
 }
+
+#[cfg(not(target_os = "macos"))]
+#[tauri::command]
+fn get_mouse_position(window: tauri::WebviewWindow) -> Result<MousePosition, String> {
+    let cursor = window.cursor_position().map_err(|e| e.to_string())?;
+    let origin = window.outer_position().map_err(|e| e.to_string())?;
+    let scale = window.scale_factor().map_err(|e| e.to_string())?;
+    Ok(MousePosition { x: (cursor.x - origin.x as f64) / scale, y: (cursor.y - origin.y as f64) / scale })
+}
