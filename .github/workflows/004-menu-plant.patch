@@ -0,0 +1,100 @@
+import type { MenuAction } from "./RadialMenu";
+import "../styles/menu.css";
+
+interface Tile {
+  action: MenuAction;
+  icon: string;
+  label: string;
+  needsPartner?: boolean;
+}
+
+const GROUPS: { title: string; tiles: Tile[] }[] = [
+  {
+    title: "💕 Zusammen",
+    tiles: [
+      { action: "messages", icon: "💌", label: "Nachrichten" },
+      { action: "kiss", icon: "😘", label: "Küsschen", needsPartner: true },
+      { action: "sendimage", icon: "🖼️", label: "Bild senden", needsPartner: true },
+      { action: "countdown", icon: "⏳", label: "Countdown" },
+      { action: "friends", icon: "🐾", label: "Freunde" },
+    ],
+  },
+  {
+    title: "🐱 Katze",
+    tiles: [
+      { action: "feed", icon: "🍣", label: "Füttern" },
+      { action: "yarn", icon: "🧶", label: "Wollknäuel" },
+      { action: "nap", icon: "😴", label: "Schlafen" },
+      { action: "home", icon: "🏠", label: "Ab ins Haus" },
+      { action: "settings", icon: "🎀", label: "Aussehen" },
+    ],
+  },
+  {
+    title: "✨ Extras",
+    tiles: [
+      { action: "music", icon: "🎵", label: "Musik" },
+      { action: "timer", icon: "⏱️", label: "Timer" },
+      { action: "notes", icon: "📝", label: "Notizen" },
+      { action: "journal", icon: "📖", label: "Tagebuch" },
+      { action: "achievements", icon: "🏆", label: "Erfolge" },
+    ],
+  },
+];
+
+export const CAT_MENU_W = 300;
+export const CAT_MENU_H = 290;
+
+interface CatMenuProps {
+  x: number;
+  y: number;
+  musicPlaying?: boolean;
+  unread: number;
+  partnerName?: string | null;
+  onSelect: (action: MenuAction) => void;
+  onClose: () => void;
+}
+
+export default function CatMenu({ x, y, musicPlaying, unread, partnerName, onSelect, onClose }: CatMenuProps) {
+  // Prefer showing the menu above the cat; flip below / clamp to the screen
+  const w = window.innerWidth;
+  const h = window.innerHeight;
+  const left = Math.max(8, Math.min(w - CAT_MENU_W - 8, x - CAT_MENU_W / 2));
+  let top = y - 48 - CAT_MENU_H;
+  if (top < 8) top = Math.min(h - CAT_MENU_H - 8, y + 48);
+
+  return (
+    <>
+      <div className="cat-menu-backdrop" onClick={onClose} />
+      <div className="cat-menu" style={{ left, top, width: CAT_MENU_W }}>
+        {GROUPS.map((g) => (
+          <div key={g.title} className="cat-menu-group">
+            <div className="cat-menu-title">{g.title}</div>
+            <div className="cat-menu-grid">
+              {g.tiles.map((t, i) => {
+                const disabled = t.needsPartner && !partnerName;
+                const icon = t.action === "music" && musicPlaying ? "🔇" : t.icon;
+                const label = t.action === "music" && musicPlaying ? "Stumm" : t.label;
+                return (
+                  <button
+                    key={t.action}
+                    className={`cat-menu-tile ${disabled ? "disabled" : ""}`}
+                    style={{ animationDelay: `${i * 25}ms` }}
+                    title={disabled ? "Füge zuerst deinen Schatz als Freund hinzu" : label}
+                    onClick={(e) => {
+                      e.stopPropagation();
+                      if (!disabled) onSelect(t.action);
+                    }}
+                  >
+                    <span className="cat-menu-icon">{icon}</span>
+                    <span className="cat-menu-label">{label}</span>
+                    {t.action === "messages" && unread > 0 && <span className="cat-menu-badge">{unread}</span>}
+                  </button>
+                );
+              })}
+            </div>
+          </div>
+        ))}
+      </div>
+    </>
+  );
+}
diff --git a/src/components/CountdownPanel.tsx b/src/components/CountdownPanel.tsx
new file mode 100644
index 0000000..04f611e
--- /dev/null
+++ b/src/components/CountdownPanel.tsx
@@ -0,0 +1,97 @@
+import { useEffect, useState } from "react";
+
+export interface CountdownT {
+  at: number; // timestamp (ms)
+  label: string;
+}
+
+export function formatRemaining(ms: number): string {
+  if (ms <= 0) return "jetzt! 🎉";
+  const s = Math.floor(ms / 1000);
+  const d = Math.floor(s / 86400);
+  const h = Math.floor((s % 86400) / 3600);
+  const m = Math.floor((s % 3600) / 60);
+  const sec = s % 60;
+  if (d > 0) return `${d} T ${h} Std ${m} Min`;
+  if (h > 0) return `${h} Std ${m} Min`;
+  if (m > 0) return `${m} Min ${sec} Sek`;
+  return `${sec} Sek`;
+}
+
+function toLocalInput(ts: number) {
+  const d = new Date(ts);
+  const p = (n: number) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
+}
+
+interface CountdownPanelProps {
+  countdown: CountdownT | null;
+  partnerName: string;
+  onSave: (c: CountdownT | null) => void;
+  onClose: () => void;
+}
+
+export default function CountdownPanel({ countdown, partnerName, onSave, onClose }: CountdownPanelProps) {
+  const [editing, setEditing] = useState(!countdown);
+  const [when, setWhen] = useState(countdown ? toLocalInput(countdown.at) : "");
+  const [label, setLabel] = useState(countdown?.label ?? "");
+  const [now, setNow] = useState(Date.now());
+
+  useEffect(() => {
+    const id = setInterval(() => setNow(Date.now()), 1000);
+    return () => clearInterval(id);
+  }, []);
+
+  const save = () => {
+    const at = new Date(when).getTime();
+    if (!when || Number.isNaN(at)) return;
+    onSave({ at, label: label.trim() || `Wiedersehen mit ${partnerName} 💕` });
+    setEditing(false);
+  };
+
+  return (
+    <div className="chat-overlay" onClick={onClose}>
+      <div className="countdown-panel" onClick={(e) => e.stopPropagation()}>
+        <div className="chat-header">
+          <span>⏳ Countdown</span>
+          <button className="chat-close" onClick={onClose}>×</button>
+        </div>
+
+        {countdown && !editing && (
+          <div className="countdown-view">
+            <div className="countdown-label">{countdown.label}</div>
+            <div className="countdown-big">{formatRemaining(countdown.at - now)}</div>
+            <div className="countdown-when">
+              {new Date(countdown.at).toLocaleString("de-DE", { weekday: "long", day: "2-digit", month: "long", hour: "2-digit", minute: "2-digit" })} Uhr
+            </div>
+            <div className="countdown-actions">
+              <button onClick={() => { setWhen(toLocalInput(countdown.at)); setLabel(countdown.label); setEditing(true); }}>Ändern</button>
+              <button className="secondary" onClick={() => { onSave(null); setEditing(true); setWhen(""); setLabel(""); }}>Löschen</button>
+            </div>
+          </div>
+        )}
+
+        {editing && (
+          <div className="countdown-edit">
+            <label>Wann?</label>
+            <input type="datetime-local" value={when} onChange={(e) => setWhen(e.target.value)} />
+            <label>Was?</label>
+            <input
+              type="text"
+              value={label}
+              maxLength={50}
+              placeholder={`z. B. Wiedersehen mit ${partnerName} 💕`}
+              onChange={(e) => setLabel(e.target.value)}
+              onKeyDown={(e) => { if (e.key === "Enter") save(); }}
+            />
+            <div className="countdown-actions">
+              <button onClick={save} disabled={!when}>Speichern</button>
+              {countdown && <button className="secondary" onClick={() => setEditing(false)}>Abbrechen</button>}
+            </div>
+            <div className="countdown-hint">Wird automatisch auch bei {partnerName} eingetragen. Deine Katze erinnert euch rechtzeitig 🐾</div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
