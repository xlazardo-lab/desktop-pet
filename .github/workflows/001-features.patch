diff --git a/src/components/ImageCard.tsx b/src/components/ImageCard.tsx
new file mode 100644
index 0000000..09e8aa3
--- /dev/null
+++ b/src/components/ImageCard.tsx
@@ -0,0 +1,57 @@
+import { useEffect } from "react";
+
+export interface ReceivedImage {
+  id: string;
+  fromName: string;
+  src: string;
+  caption?: string;
+}
+
+interface ImageCardProps {
+  image: ReceivedImage;
+  x: number;
+  y: number;
+  queued: number;
+  onClose: () => void;
+}
+
+export const IMAGE_CARD_W = 280;
+export const IMAGE_CARD_H = 340;
+
+/** Where the card is drawn for a pet at (petX, petY) — shared with the click hit-zone. */
+export function imageCardCenter(petX: number, petY: number) {
+  const w = window.innerWidth;
+  const h = window.innerHeight;
+  const cx = Math.max(IMAGE_CARD_W / 2 + 10, Math.min(w - IMAGE_CARD_W / 2 - 10, petX));
+  let cy = petY - 60 - IMAGE_CARD_H / 2;
+  if (cy - IMAGE_CARD_H / 2 < 10) cy = petY + 60 + IMAGE_CARD_H / 2;
+  cy = Math.max(IMAGE_CARD_H / 2 + 10, Math.min(h - IMAGE_CARD_H / 2 - 10, cy));
+  return { x: cx, y: cy };
+}
+
+export default function ImageCard({ image, x, y, queued, onClose }: ImageCardProps) {
+  // Close automatically after 90 seconds
+  useEffect(() => {
+    const t = setTimeout(onClose, 90_000);
+    return () => clearTimeout(t);
+  }, [image.id, onClose]);
+
+  return (
+    <div
+      className="image-card"
+      style={{ left: x - IMAGE_CARD_W / 2, top: y - IMAGE_CARD_H / 2, width: IMAGE_CARD_W, height: IMAGE_CARD_H }}
+      onClick={onClose}
+      title="Klicken zum Schließen"
+    >
+      <div className="image-card-header">
+        <span>📬 von {image.fromName}</span>
+        <button className="image-card-close" onClick={onClose}>×</button>
+      </div>
+      <div className="image-card-body">
+        <img src={image.src} alt="" draggable={false} />
+      </div>
+      {image.caption && <div className="image-card-caption">{image.caption}</div>}
+      {queued > 0 && <div className="image-card-more">+{queued} weitere</div>}
+    </div>
+  );
+}
