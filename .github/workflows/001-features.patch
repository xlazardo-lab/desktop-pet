diff --git a/src/lib/actions.ts b/src/lib/actions.ts
new file mode 100644
index 0000000..779354b
--- /dev/null
+++ b/src/lib/actions.ts
@@ -0,0 +1,72 @@
+// Interactions between friends are sent through the existing `visits.message`
+// column. Plain text = chat message; text starting with ACTION_PREFIX = JSON action.
+
+export const ACTION_PREFIX = "\u0001PET:";
+
+export type PetAction =
+  | { t: "feed"; snack: string }
+  | { t: "pet" }
+  | { t: "img"; src: string; caption?: string };
+
+export function encodeAction(action: PetAction): string {
+  return ACTION_PREFIX + JSON.stringify(action);
+}
+
+export function decodeAction(message: string): PetAction | null {
+  if (!message || !message.startsWith(ACTION_PREFIX)) return null;
+  try {
+    const a = JSON.parse(message.slice(ACTION_PREFIX.length));
+    if (a && (a.t === "feed" || a.t === "pet" || a.t === "img")) return a as PetAction;
+  } catch {
+    /* ignore malformed */
+  }
+  return null;
+}
+
+const MAX_SIDE = 520;
+const MAX_GIF_BYTES = 450 * 1024;
+
+function readAsDataUrl(file: Blob): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const r = new FileReader();
+    r.onload = () => resolve(r.result as string);
+    r.onerror = () => reject(r.error);
+    r.readAsDataURL(file);
+  });
+}
+
+/** Shrinks an image so it fits comfortably into a database row. */
+export async function imageFileToDataUrl(file: Blob): Promise<string> {
+  // Small GIFs stay animated
+  if (file.type === "image/gif" && file.size <= MAX_GIF_BYTES) {
+    return readAsDataUrl(file);
+  }
+  const url = await readAsDataUrl(file);
+  const img = new Image();
+  await new Promise<void>((resolve, reject) => {
+    img.onload = () => resolve();
+    img.onerror = () => reject(new Error("Bild konnte nicht gelesen werden"));
+    img.src = url;
+  });
+  const scale = Math.min(1, MAX_SIDE / Math.max(img.width, img.height));
+  const canvas = document.createElement("canvas");
+  canvas.width = Math.max(1, Math.round(img.width * scale));
+  canvas.height = Math.max(1, Math.round(img.height * scale));
+  const ctx = canvas.getContext("2d");
+  if (!ctx) return url;
+  ctx.fillStyle = "#fff";
+  ctx.fillRect(0, 0, canvas.width, canvas.height);
+  ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+  return canvas.toDataURL("image/jpeg", 0.78);
+}
+
+/** Opens the system file picker and returns the chosen image (or null). */
+export function pickImageFile(): Promise<File | null> {
+  return new Promise((resolve) => {
+    const input = document.createElement("input");
+    input.type = "file";
+    input.accept = "image/*";
+    input.onchange = () => resolve(input.files?.[0] ?? null);
+    input.click();
+  });
+}
