+import { useEffect, useRef, useState } from "react";
+
+export interface ChatEntry {
+  id: string;
+  friendId: string;
+  friendName: string;
+  fromMe: boolean;
+  text?: string;
+  img?: string;
+  ts: number;
+}
+
+interface ChatPanelProps {
+  entries: ChatEntry[];
+  friends: { id: string; name: string }[];
+  defaultFriendId: string | null;
+  onSend: (friendId: string, text: string) => void;
+  onSendImage: (friendId: string, file?: File) => void;
+  onClose: () => void;
+}
+
+function fmt(ts: number) {
+  const d = new Date(ts);
+  const today = new Date();
+  const time = d.toLocaleTimeString("de-DE", { hour: "2-digit", minute: "2-digit" });
+  if (d.toDateString() === today.toDateString()) return time;
+  return `${d.toLocaleDateString("de-DE", { day: "2-digit", month: "2-digit" })} ${time}`;
+}
+
+export default function ChatPanel({ entries, friends, defaultFriendId, onSend, onSendImage, onClose }: ChatPanelProps) {
+  const [friendId, setFriendId] = useState<string | null>(defaultFriendId ?? friends[0]?.id ?? null);
+  const [text, setText] = useState("");
+  const [zoom, setZoom] = useState<string | null>(null);
+  const listRef = useRef<HTMLDivElement>(null);
+  const shown = entries.filter((e) => !friendId || e.friendId === friendId);
+
+  useEffect(() => {
+    listRef.current?.scrollTo({ top: listRef.current.scrollHeight });
+  }, [shown.length, friendId]);
+
+  const send = () => {
+    const t = text.trim();
+    if (!t || !friendId) return;
+    onSend(friendId, t);
+    setText("");
+  };
+
+  return (
+    <div className="chat-overlay" onClick={onClose}>
+      <div className="chat-panel" onClick={(e) => e.stopPropagation()}>
+        <div className="chat-header">
+          <span>💌 Nachrichten</span>
+          {friends.length > 1 && (
+            <select value={friendId ?? ""} onChange={(e) => setFriendId(e.target.value)}>
+              {friends.map((f) => <option key={f.id} value={f.id}>{f.name}</option>)}
+            </select>
+          )}
+          <button className="chat-close" onClick={onClose}>×</button>
+        </div>
+        <div className="chat-list" ref={listRef}>
+          {shown.length === 0 && <div className="chat-empty">Noch keine Nachrichten 🐾</div>}
+          {shown.map((e) => (
+            <div key={e.id} className={`chat-msg ${e.fromMe ? "me" : "them"}`}>
+              <div className="chat-bubble">
+                {e.img && <img src={e.img} alt="" onClick={() => setZoom(e.img!)} />}
+                {e.text && <span>{e.text}</span>}
+              </div>
+              <div className="chat-meta">{e.fromMe ? "du" : e.friendName} · {fmt(e.ts)}</div>
+            </div>
+          ))}
+        </div>
+        {friendId ? (
+          <div className="chat-input-row">
+            <button className="chat-img-btn" title="Bild / Meme" onClick={() => onSendImage(friendId)}>🖼️</button>
+            <input
+              autoFocus
+              value={text}
+              maxLength={300}
+              placeholder="Schreib etwas Süßes… (Strg+V für Bilder)"
+              onChange={(e) => setText(e.target.value)}
+              onKeyDown={(e) => { if (e.key === "Enter") send(); if (e.key === "Escape") onClose(); }}
+              onPaste={(e) => {
+                const item = Array.from(e.clipboardData.items).find((i) => i.type.startsWith("image/"));
+                const file = item?.getAsFile();
+                if (file) {
+                  e.preventDefault();
+                  onSendImage(friendId, file);
+                }
+              }}
+            />
+            <button className="chat-send-btn" onClick={send}>➤</button>
+          </div>
+        ) : (
+          <div className="chat-empty">Füge zuerst einen Freund hinzu.</div>
+        )}
+        {zoom && (
+          <div className="chat-zoom" onClick={() => setZoom(null)}>
+            <img src={zoom} alt="" />
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/CoupleCorner.tsx b/src/components/CoupleCorner.tsx
new file mode 100644
index 0000000..ad2c641
--- /dev/null
+++ b/src/components/CoupleCorner.tsx
@@ -0,0 +1,124 @@
+import { useState } from "react";
+
+export interface PlantState {
+  points: number;
+  waterMe?: string;   // YYYY-MM-DD
+  waterThem?: string; // YYYY-MM-DD
+  lastWater?: number; // timestamp
+}
+
+export interface Countdown {
+  date: string; // YYYY-MM-DD
+  label: string;
+}
+
+export const CORNER_W = 250;
+export const CORNER_H = 130;
+
+export function todayStr(d = new Date()): string {
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+}
+
+function plantLook(points: number): { emoji: string; size: number; label: string } {
+  if (points >= 21) return { emoji: "💐", size: 40, label: "in voller Blüte!" };
+  if (points >= 14) return { emoji: "🌷", size: 38, label: "blüht" };
+  if (points >= 8) return { emoji: "🌷", size: 30, label: "Knospe" };
+  if (points >= 4) return { emoji: "🌿", size: 30, label: "wächst" };
+  if (points >= 1) return { emoji: "🌱", size: 26, label: "Keimling" };
+  return { emoji: "🟤", size: 12, label: "Samen – gieß mich!" };
+}
+
+function daysUntil(date: string): number {
+  const [y, m, d] = date.split("-").map(Number);
+  const target = new Date(y, m - 1, d).getTime();
+  const now = new Date();
+  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
+  return Math.round((target - today) / 86_400_000);
+}
+
+interface CoupleCornerProps {
+  partnerName: string;
+  plant: PlantState;
+  countdown: Countdown | null;
+  onWater: () => void;
+  onSetCountdown: (c: Countdown | null) => void;
+  onEditingChange: (editing: boolean) => void;
+}
+
+export default function CoupleCorner({ partnerName, plant, countdown, onWater, onSetCountdown, onEditingChange }: CoupleCornerProps) {
+  const [editing, setEditingState] = useState(false);
+  const [date, setDate] = useState(countdown?.date ?? "");
+  const [label, setLabel] = useState(countdown?.label ?? "");
+  const [splash, setSplash] = useState(0);
+
+  const setEditing = (v: boolean) => {
+    setEditingState(v);
+    onEditingChange(v);
+    if (v) {
+      setDate(countdown?.date ?? "");
+      setLabel(countdown?.label ?? "");
+    }
+  };
+
+  const today = todayStr();
+  const wilted = plant.points > 0 && plant.lastWater !== undefined && Date.now() - plant.lastWater > 3 * 86_400_000;
+  const look = plantLook(plant.points);
+  const meDone = plant.waterMe === today;
+  const themDone = plant.waterThem === today;
+
+  let cdText = "";
+  if (countdown) {
+    const d = daysUntil(countdown.date);
+    if (d > 1) cdText = `Noch ${d} Tage: ${countdown.label}`;
+    else if (d === 1) cdText = `Morgen: ${countdown.label}! 🥰`;
+    else if (d === 0) cdText = `Heute: ${countdown.label}! 🎉`;
+    else cdText = `${countdown.label} war vor ${-d} T.`;
+  }
+
+  return (
+    <div className="couple-corner" style={{ width: CORNER_W, height: CORNER_H }}>
+      <div
+        className={`couple-plant ${wilted ? "wilted" : ""}`}
+        onClick={() => {
+          if (meDone) return;
+          setSplash(Date.now());
+          onWater();
+        }}
+        title={meDone ? "Heute schon gegossen 💧" : "Klicken zum Gießen 💧"}
+      >
+        {splash > 0 && (
+          <div className="couple-water" key={splash}>
+            <span>💧</span><span>💧</span><span>💧</span>
+          </div>
+        )}
+        <div className="couple-plant-emoji" style={{ fontSize: look.size }}>{wilted ? "🥀" : look.emoji}</div>
+        <div className="couple-pot" />
+        <div className="couple-plant-info">
+          <span className={meDone ? "done" : ""}>💧 du</span>
+          <span className={themDone ? "done" : ""}>💧 {partnerName}</span>
+        </div>
+      </div>
+
+      <div className="couple-sign" onClick={() => !editing && setEditing(true)} title="Countdown einstellen">
+        {!editing && (countdown ? <span>📅 {cdText}</span> : <span className="couple-sign-empty">📅 Countdown setzen…</span>)}
+        {editing && (
+          <div className="couple-editor" onClick={(e) => e.stopPropagation()}>
+            <input type="date" value={date} onChange={(e) => setDate(e.target.value)} />
+            <input type="text" value={label} maxLength={40} placeholder="z.B. Wiedersehen 💕" onChange={(e) => setLabel(e.target.value)} />
+            <div className="couple-editor-row">
+              <button
+                onClick={() => {
+                  if (date) onSetCountdown({ date, label: label.trim() || "Wiedersehen 💕" });
+                  setEditing(false);
+                }}
+              >Speichern</button>
+              {countdown && <button onClick={() => { onSetCountdown(null); setEditing(false); }}>Löschen</button>}
+              <button onClick={() => setEditing(false)}>✕</button>
+            </div>
+          </div>
+        )}
+      </div>
+      <div className="couple-plant-label">{wilted ? "Durstig! 🥺" : look.label}</div>
+    </div>
+  );
+}
