@@ -0,0 +1,19 @@
+import { accessoryById } from "../lib/look";
+
+/** Draws the accessory emoji on top of a 64×64 cat sprite box. */
+export default function AccessoryBadge({ id, flip }: { id?: string | null; flip?: boolean }) {
+  const acc = accessoryById(id);
+  if (!acc) return null;
+  return (
+    <span
+      className="pet-accessory"
+      style={{
+        top: -4 + (acc.dy ?? 0),
+        fontSize: acc.size ?? 18,
+        transform: `translateX(-50%) ${flip ? "scaleX(-1)" : ""}`,
+      }}
+    >
+      {acc.emoji}
+    </span>
+  );
+}
