diff --git a/src/components/PlantWidget.tsx b/src/components/PlantWidget.tsx
new file mode 100644
index 0000000..131847f
--- /dev/null
+++ b/src/components/PlantWidget.tsx
@@ -0,0 +1,247 @@
+import { useMemo, useRef, useState } from "react";
+import type { PlantState } from "./CoupleCorner";
+import { todayStr } from "./CoupleCorner";
+
+// ---------------------------------------------------------------------------
+// A shared plant that grows very slowly (each watering = 1 point, max 2/day when
+// both water). After a few months it becomes a huge blossoming tree.
+// ---------------------------------------------------------------------------
+
+export interface PlantPos { x: number; y: number } // bottom-center of the pot
+
+function rng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0;
+    return s / 4294967296;
+  };
+}
+
+function bezier(t: number, p0: number, p1: number, p2: number, p3: number) {
+  const u = 1 - t;
+  return u * u * u * p0 + 3 * u * u * t * p1 + 3 * u * t * t * p2 + t * t * t * p3;
+}
+
+export function plantHeight(points: number) {
+  const max = Math.max(200, window.innerHeight * 0.85);
+  return Math.min(max, 14 + points * 3.4);
+}
+
+export function potWidth(points: number) {
+  return Math.min(110, 42 + points * 0.35);
+}
+
+export function plantStage(points: number): string {
+  if (points >= 180) return "Zauberbaum ✨";
+  if (points >= 130) return "Blütenbaum 🌸";
+  if (points >= 90) return "kleiner Baum";
+  if (points >= 55) return "großer Busch";
+  if (points >= 30) return "blüht 🌷";
+  if (points >= 15) return "Knospe";
+  if (points >= 5) return "wächst";
+  if (points >= 1) return "Keimling";
+  return "Samen – gieß mich!";
+}
+
+const PETALS = ["#ff8fb5", "#ffb3cf", "#ff6f9c", "#ffc9de", "#f78fd0", "#ffd36e"];
+
+function Flower({ x, y, r, seed }: { x: number; y: number; r: number; seed: number }) {
+  const rand = rng(seed);
+  const color = PETALS[Math.floor(rand() * PETALS.length)];
+  const petals = 5;
+  const rot = rand() * 72;
+  return (
+    <g transform={`translate(${x},${y}) rotate(${rot})`}>
+      {Array.from({ length: petals }, (_, i) => {
+        const a = (i / petals) * Math.PI * 2;
+        return <ellipse key={i} cx={Math.cos(a) * r * 0.62} cy={Math.sin(a) * r * 0.62} rx={r * 0.55} ry={r * 0.4} fill={color} transform={`rotate(${(a * 180) / Math.PI} ${Math.cos(a) * r * 0.62} ${Math.sin(a) * r * 0.62})`} />;
+      })}
+      <circle r={r * 0.32} fill="#ffe066" />
+    </g>
+  );
+}
+
+function Leaf({ x, y, len, angle, wilted }: { x: number; y: number; len: number; angle: number; wilted: boolean }) {
+  const a = wilted ? angle + (angle > 0 ? 35 : -35) : angle;
+  return (
+    <path
+      d={`M0,0 Q${len / 2},${-len / 3} ${len},0 Q${len / 2},${len / 3} 0,0`}
+      fill={wilted ? "#9aa66b" : "#5dbb63"}
+      stroke={wilted ? "#6f7a45" : "#3d8b45"}
+      strokeWidth={0.8}
+      transform={`translate(${x},${y}) rotate(${a})`}
+    />
+  );
+}
+
+function PlantSvg({ points, wilted }: { points: number; wilted: boolean }) {
+  const H = plantHeight(points);
+  const W = Math.max(90, H * 0.9);
+  const stemW = Math.min(16, 2 + points * 0.08);
+
+  const parts = useMemo(() => {
+    const els: JSX.Element[] = [];
+    if (points < 1) {
+      els.push(<ellipse key="seed" cx={0} cy={-3} rx={5} ry={3.5} fill="#8a5a2b" />);
+      return els;
+    }
+    const sway = H * 0.07;
+    const c = { x0: 0, y0: 0, x1: sway, y1: -H / 3, x2: -sway, y2: (-2 * H) / 3, x3: 0, y3: -H };
+    const pt = (t: number) => ({ x: bezier(t, c.x0, c.x1, c.x2, c.x3), y: bezier(t, c.y0, c.y1, c.y2, c.y3) });
+
+    // Branches (after a bush stage)
+    const branchCount = points >= 45 ? Math.min(9, Math.floor((points - 45) / 16) + 1) : 0;
+    for (let i = 0; i < branchCount; i++) {
+      const rand = rng(1000 + i * 17);
+      const t = 0.32 + (i / Math.max(1, branchCount)) * 0.55 + rand() * 0.04;
+      const p = pt(t);
+      const side = i % 2 === 0 ? 1 : -1;
+      const grow = Math.min(1, (points - 45 - i * 16) / 40);
+      const len = H * (0.22 + rand() * 0.12) * Math.max(0.2, grow) * (1 - t * 0.35);
+      const ex = p.x + side * len;
+      const ey = p.y - len * 0.55;
+      const bw = Math.max(1.5, stemW * 0.45 * (1 - t * 0.5));
+      els.push(<path key={`b${i}`} d={`M${p.x},${p.y} Q${p.x + side * len * 0.5},${p.y - len * 0.05} ${ex},${ey}`} stroke={wilted ? "#7a6a4a" : "#6b4a2b"} strokeWidth={bw} fill="none" strokeLinecap="round" />);
+      const nl = Math.min(7, 2 + Math.floor(grow * 5));
+      for (let k = 1; k <= nl; k++) {
+        const tt = k / (nl + 1);
+        const lx = p.x + (ex - p.x) * tt;
+        const ly = p.y + (ey - p.y) * tt - Math.sin(tt * Math.PI) * len * 0.05;
+        els.push(<Leaf key={`b${i}l${k}`} x={lx} y={ly} len={10 + Math.min(22, points * 0.1)} angle={(k % 2 ? -1 : 1) * 50 - 90 + side * 30} wilted={wilted} />);
+      }
+      if (points >= 70 && !wilted) {
+        const fr = Math.min(22, 7 + (points - 70) * 0.08);
+        els.push(<Flower key={`bf${i}`} x={ex} y={ey} r={fr} seed={i * 7 + 3} />);
+        if (points >= 130) {
+          els.push(<Flower key={`bf2${i}`} x={p.x + (ex - p.x) * 0.55} y={p.y + (ey - p.y) * 0.55 - 6} r={fr * 0.7} seed={i * 13 + 5} />);
+        }
+      }
+    }
+
+    // Main stem
+    els.push(
+      <path key="stem" d={`M${c.x0},${c.y0} C${c.x1},${c.y1} ${c.x2},${c.y2} ${c.x3},${c.y3}`} stroke={wilted ? "#7f8f55" : points >= 90 ? "#6b4a2b" : "#3f9a48"} strokeWidth={stemW} fill="none" strokeLinecap="round" />,
+    );
+
+    // Leaves along the stem
+    const leafCount = Math.min(36, Math.floor(points / 2) + 1);
+    for (let i = 0; i < leafCount; i++) {
+      const t = 0.12 + (i / Math.max(1, leafCount)) * 0.82;
+      const p = pt(t);
+      const side = i % 2 === 0 ? 1 : -1;
+      const len = (9 + Math.min(30, points * 0.22)) * (1 - t * 0.35);
+      els.push(<Leaf key={`l${i}`} x={p.x} y={p.y} len={len} angle={side > 0 ? -35 : -145} wilted={wilted} />);
+    }
+
+    // Top: bud → flower → crown of flowers
+    const top = pt(1);
+    if (points >= 15 && points < 30) {
+      els.push(<ellipse key="bud" cx={top.x} cy={top.y - 6} rx={6} ry={9} fill={wilted ? "#b38a9a" : "#ff9fc0"} stroke="#3f9a48" strokeWidth={1.5} />);
+    } else if (points >= 30) {
+      const r = Math.min(46, 10 + (points - 30) * 0.18);
+      if (points >= 110 && !wilted) {
+        for (let k = 0; k < 6; k++) {
+          const a = (k / 6) * Math.PI * 2;
+          els.push(<Flower key={`crown${k}`} x={top.x + Math.cos(a) * r * 1.2} y={top.y - r * 0.6 + Math.sin(a) * r * 0.7} r={r * 0.55} seed={k * 31 + 11} />);
+        }
+      }
+      els.push(<Flower key="top" x={top.x} y={top.y - r * 0.6} r={wilted ? r * 0.7 : r} seed={42} />);
+    }
+    return els;
+  }, [points, wilted, H, stemW]);
+
+  return (
+    <svg
+      className={`plant-svg ${wilted ? "wilted" : ""}`}
+      width={W}
+      height={H + 60}
+      viewBox={`${-W / 2} ${-H - 50} ${W} ${H + 60}`}
+      style={{ filter: wilted ? "grayscale(0.55)" : undefined }}
+    >
+      <g className="plant-sway">{parts}</g>
+    </svg>
+  );
+}
+
+interface PlantWidgetProps {
+  plant: PlantState;
+  partnerName: string;
+  pos: PlantPos;
+  onMove: (pos: PlantPos) => void;
+  onWater: () => void;
+  onDragChange: (dragging: boolean) => void;
+}
+
+export const POT_H = 34;
+
+export default function PlantWidget({ plant, partnerName, pos, onMove, onWater, onDragChange }: PlantWidgetProps) {
+  const [splash, setSplash] = useState(0);
+  const dragRef = useRef<{ sx: number; sy: number; ox: number; oy: number; moved: boolean } | null>(null);
+  const today = todayStr();
+  const meDone = plant.waterMe === today;
+  const themDone = plant.waterThem === today;
+  const wilted = plant.points > 0 && plant.lastWater !== undefined && Date.now() - plant.lastWater > 3 * 86_400_000;
+  const potW = potWidth(plant.points);
+  const H = plantHeight(plant.points);
+
+  const onMouseDown = (e: React.MouseEvent) => {
+    e.preventDefault();
+    dragRef.current = { sx: e.clientX, sy: e.clientY, ox: pos.x, oy: pos.y, moved: false };
+    const move = (ev: MouseEvent) => {
+      const d = dragRef.current;
+      if (!d) return;
+      const dx = ev.clientX - d.sx;
+      const dy = ev.clientY - d.sy;
+      if (!d.moved && Math.abs(dx) + Math.abs(dy) > 5) {
+        d.moved = true;
+        onDragChange(true);
+      }
+      if (d.moved) {
+        onMove({
+          x: Math.max(potW / 2, Math.min(window.innerWidth - potW / 2, d.ox + dx)),
+          y: Math.max(POT_H + 40, Math.min(window.innerHeight - 4, d.oy + dy)),
+        });
+      }
+    };
+    const up = () => {
+      window.removeEventListener("mousemove", move);
+      window.removeEventListener("mouseup", up);
+      const d = dragRef.current;
+      dragRef.current = null;
+      if (d?.moved) {
+        onDragChange(false);
+      } else if (!meDone) {
+        setSplash(Date.now());
+        onWater();
+      }
+    };
+    window.addEventListener("mousemove", move);
+    window.addEventListener("mouseup", up);
+  };
+
+  return (
+    <div className="plant-widget" style={{ left: pos.x, top: pos.y }}>
+      <div className="plant-graphic" style={{ bottom: POT_H - 6 }}>
+        <PlantSvg points={plant.points} wilted={wilted} />
+      </div>
+      {splash > 0 && (
+        <div className="couple-water" key={splash} style={{ bottom: POT_H + Math.min(H, 120) * 0.5 }}>
+          <span>💧</span><span>💧</span><span>💧</span>
+        </div>
+      )}
+      <div
+        className="plant-pot"
+        style={{ width: potW, height: POT_H }}
+        onMouseDown={onMouseDown}
+        title={meDone ? "Heute schon gegossen 💧 (ziehen zum Verschieben)" : "Klicken zum Gießen 💧 · Ziehen zum Verschieben"}
+      >
+        <div className="plant-pot-rim" />
+      </div>
+      <div className="plant-info">
+        <span className={meDone ? "done" : ""}>💧 du</span>
+        <span className={themDone ? "done" : ""}>💧 {partnerName}</span>
+      </div>
+      <div className="plant-label">{wilted ? "Durstig! 🥺" : plantStage(plant.points)}</div>
+    </div>
+  );
+}
